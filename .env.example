# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://tribrizs.com

# Contact details shown across the site. Defaults to +1 (877) 370-5969 if unset.
NEXT_PUBLIC_CONTACT_PHONE="+1 (877) 370-5969"
NEXT_PUBLIC_CONTACT_EMAIL=support@tribrizs.com
NEXT_PUBLIC_BUSINESS_HOURS="24/7 Phone Assistance"
NEXT_PUBLIC_GTAG_ID=AW-18481256480

# Where enquiries are delivered (server-only). Any endpoint that accepts a
# JSON POST works: a CRM webhook, Zapier/Make, or your own API route that
# sends mail through Resend. Without it, production submissions fail loudly
# instead of silently dropping leads; in development they are logged.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
